# Токен бота — получить у @BotFather (создавать бота лучше с аккаунта заказчика,
# чтобы бот принадлежал ему).
BOT_TOKEN=

# Название бренда — подставляется в тексты сообщений.
BRAND_NAME=Бренд

# Ссылка на канал бренда, куда бот отправляет подписчика после капсулы.
# Формат: https://t.me/название_канала
CHANNEL_URL=https://t.me/

# Telegram ID администраторов через запятую — им доступна команда /stats.
# Узнать свой ID можно у бота @userinfobot.
ADMIN_IDS=

# Путь к файлу базы данных SQLite (можно оставить по умолчанию).
DB_PATH=./data/leads.db
